<?xml version="1.0" encoding="UTF-8"?>
<!--
  Better Brush — Premiere Pro panel (CEP).

  Targets Premiere Pro 2022+ (host id PPRO) on Windows. This is the same panel
  as the After Effects one; only js/host.jsx differs, because Premiere's
  ExtendScript object model is not After Effects'.

  CEP is used rather than UXP because the work needs the ExtendScript object
  model: Sequence.getSelection + ProjectItem.changeMediaPath are only reliably
  scriptable through ExtendScript today.
-->
<ExtensionManifest Version="7.0"
                   ExtensionBundleId="com.snegdev.betterbrush.premiere"
                   ExtensionBundleVersion="0.1.0"
                   ExtensionBundleName="Better Brush (Premiere Pro)">

  <ExtensionList>
    <Extension Id="com.snegdev.betterbrush.premiere.panel" Version="0.1.0"/>
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[22.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="com.snegdev.betterbrush.premiere.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./js/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--disable-features=OutOfBlinkCors</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Better Brush</Menu>
          <Geometry>
            <Size>
              <Width>340</Width>
              <Height>480</Height>
            </Size>
            <MinSize>
              <Width>280</Width>
              <Height>320</Height>
            </MinSize>
            <MaxSize>
              <Width>4000</Width>
              <Height>4000</Height>
            </MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
